import { ListView, ScrollView } from "std-widgets.slint";
// Colours follow Telegram Desktop's night theme; OLED mode turns surfaces black.
export global Theme {
    in-out property <bool> oled: false;
    out property <color> window: oled ? #000000 : #0e1621;
    out property <color> panel: oled ? #000000 : #17212b;
    out property <color> field: oled ? #000000 : #242f3d;
    out property <color> incoming: oled ? #101010 : #182533;
    out property <color> outgoing: oled ? #0b2236 : #2b5278;
    out property <color> selected: oled ? #0b2236 : #2b5278;
    out property <color> hover: oled ? #101010 : #202b36;
    out property <color> date: oled ? #1a1a1acc : #1e2c3acc;
    out property <color> border: oled ? #1a1a1a : #0b131b;
    out property <color> text: #ffffff;
    out property <color> muted: #7f91a4;
    out property <color> time-in: #6d7f8f;
    out property <color> time-out: #7da8d3;
    out property <color> check: #72bcfd;
    out property <color> badge: #3e88c7;
    out property <color> accent: #6ab3f3;
    // Interaction states of the accent and of quiet surfaces.
    out property <color> accent-hover: #8ccaff;
    out property <color> badge-hover: #4a96d6;
    out property <color> badge-muted: #637383;
    out property <color> accent-wash: #6ab3f312;
    out property <color> highlight: #386080;
    // Reaction chips: a wash of the accent (incoming) or of white (outgoing); a chosen chip is
    // filled with the accent and its count takes the bubble colour, as in Telegram Desktop.
    out property <color> reaction-in: #6ab3f326;
    out property <color> reaction-in-hover: #6ab3f340;
    out property <color> reaction-out: #ffffff1f;
    out property <color> reaction-out-hover: #ffffff33;
    out property <color> reaction-out-text: #e4f0fc;
    out property <color> reaction-picked: #6ab3f333;
    // Popover surfaces sit one step above the panel; their edge is a faint light line.
    out property <color> menu: oled ? #121212 : #1d2733;
    out property <color> menu-hover: #ffffff12;
    out property <color> menu-edge: #ffffff0d;
    out property <color> menu-icon: #e8edf2;
    out property <color> field-edge: #2f3e4e;
    out property <color> icon-idle: #4f5f70;
    // Content on strong surfaces (accent, selection, media, scrims) is white at three levels.
    out property <color> on-strong: #ffffff;
    out property <color> on-strong-2: #ffffffd0;
    out property <color> on-strong-3: #ffffffb0;
    out property <color> track: #ffffff30;
    out property <color> scrim: #00000080;
    out property <color> scrim-hover: #000000a0;
    out property <color> shadow: #00000080;
    out property <color> media-black: #000000;
    out property <color> qr-paper: #ffffff;
    out property <color> avatar-fallback: #65aadd;
    // Status. Banners use a dark tint of the status hue with a light text of the same hue.
    out property <color> danger: #e5505a;
    out property <color> warning-surface: #3a2d1b;
    out property <color> warning-text: #edbb76;
    out property <color> error-surface: #3b2226;
    out property <color> error-text: #ffb4b4;
    // Type sizes, as in Telegram Desktop. Weight 600 marks names and titles.
    out property <length> type-caption: 11px;
    out property <length> type-meta: 12px;
    out property <length> type-small: 13px;
    out property <length> type-body: 14px;
    out property <length> type-title: 15px;
    out property <length> type-heading: 16px;
    out property <length> type-dialog: 19px;
    out property <length> type-display: 22px;
    // Corner radii. Circles and pills use half their height instead.
    out property <length> radius-small: 4px;
    out property <length> radius-control: 6px;
    out property <length> radius-panel: 10px;
    out property <length> radius-bubble: 12px;
}
export struct ChatRow { avatar: image, initials: string, color: color, title: string, preview: string, time: string, unread: string, mentions: string, muted: bool, selected: bool }
export struct WaveBar { amplitude: length, played: bool }
export struct PhotoCell { raster-width: length, raster-height: length, image: image, label: string, x: length, y: length, width: length, height: length, video: bool, duration: string }
// A reaction chip; x and y are relative to the reaction block, its height is 26 px.
export struct ReactionChip { x: length, y: length, width: length, emoji: image, count: string, chosen: bool, reaction: string }
export struct QuickReaction { emoji: image, reaction: string, chosen: bool }
// One feed row: a date separator (optional) and one bubble holding a message or an album.
export struct MessageRow {
    voice: bool, voice-playing: bool, voice-unlistened: bool, voice-time: string, waveform: [WaveBar],
    document: bool, file-name: string, file-size: string, file-progress: string,
    file-available: bool, file-downloading: bool, attachment-image: image, attachment-y: length,
    sticker: bool, round: bool, round-active: bool, emoji: bool, round-progress: string,
    key: string, can-edit: bool, can-delete: bool, can-forward: bool, can-reply: bool,
    // A service message: a centred pill with the rendered text, no bubble.
    service: bool,
    highlighted: bool, forwarded: string, sender-y: length,
    has-quote: bool, quote-y: length, quote-sender: string, quote-preview: string, quote-color: color,
    time-label-width: length,
    row-y: length, height: length, date: string, unread: bool, unread-y: length,
    bubble-y: length, bubble-width: length, bubble-height: length, outgoing: bool, tail: bool,
    sender: string, sender-color: color,
    media-y: length, media-width: length, media-height: length, media-caption: bool, cells: [PhotoCell],
    rendered: image, text-y: length, text-width: length, text-height: length,
    time: string, time-x: length, time-y: length, time-over-media: bool,
    // 0 none, 1 sent, 2 read, -1 sending, -2 failed.
    checks: int,
    reactions: [ReactionChip], reactions-y: length, can-react: bool,
}
// Hit testing is a pure binding to pointer coordinates: no timers or reshaping on hover.
component MessageText inherits Image {
    in property <bool> enabled: true;
    pure callback target-at(x: length, y: length) -> string;
    callback activate(x: length, y: length);
    callback context-menu(x: length, y: length);
    TouchArea {
        property <string> pressed-target;
        property <bool> dragged;
        enabled: root.enabled;
        mouse-cursor: self.has-hover && root.target-at(self.mouse-x, self.mouse-y) != "" ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.pressed-target = root.target-at(self.mouse-x, self.mouse-y);
                self.dragged = false;
            }
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if event.kind == PointerEventKind.cancel { self.pressed-target = ""; }
        }
        moved => {
            if abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px { self.dragged = true; }
        }
        clicked => {
            if !self.dragged && self.pressed-target != "" && self.pressed-target == root.target-at(self.mouse-x, self.mouse-y) {
                root.activate(self.mouse-x, self.mouse-y);
            }
            self.pressed-target = "";
        }
    }
}
component Action inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    min-width: 80px;
    border-radius: Theme.radius-control;
    background: touch.has-hover && root.enabled ? Theme.badge-hover : Theme.badge;
    opacity: root.enabled ? 1 : 0.5;
    Text { text: root.text; color: Theme.on-strong; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.type-body; font-weight: 600; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component Link inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 32px;
    Text { text: root.text; color: touch.has-hover ? Theme.accent-hover : Theme.accent; horizontal-alignment: center; vertical-alignment: center; font-size: Theme.type-body; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
// A percentage slider in fixed steps, like Telegram Desktop's interface scale slider.
component ScaleSlider inherits Rectangle {
    in-out property <int> value: 100;
    in property <int> minimum: 50;
    in property <int> maximum: 300;
    in property <int> step: 5;
    callback edited();
    height: 24px;
    track := Rectangle {
        x: 8px; y: (parent.height - 4px) / 2; width: parent.width - 16px; height: 4px;
        border-radius: 2px; background: Theme.field-edge;
    }
    Rectangle {
        x: track.x; y: track.y; height: track.height; border-radius: 2px; background: Theme.accent;
        width: (root.value - root.minimum) / (root.maximum - root.minimum) * track.width;
    }
    Rectangle {
        width: 16px; height: 16px; border-radius: 8px; background: Theme.accent;
        x: track.x + (root.value - root.minimum) / (root.maximum - root.minimum) * track.width - 8px;
        y: (parent.height - 16px) / 2;
    }
    TouchArea {
        mouse-cursor: MouseCursor.pointer;
        function pick(position: length) {
            root.value = root.minimum + round(clamp((position - track.x) / track.width, 0, 1)
                * (root.maximum - root.minimum) / root.step) * root.step;
            root.edited();
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.pick(self.mouse-x);
            }
        }
        moved => { if self.pressed { self.pick(self.mouse-x); } }
    }
}
component Input inherits Rectangle {
    in-out property <string> text;
    in property <bool> secret;
    callback accepted();
    height: 44px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: entry.has-focus ? Theme.accent : Theme.field-edge;
    background: Theme.field;
    entry := TextInput {
        x: 12px; y: 11px; width: parent.width - 24px; height: 22px;
        text <=> root.text;
        color: Theme.text;
        selection-background-color: Theme.selected;
        selection-foreground-color: Theme.on-strong;
        font-size: Theme.type-title;
        single-line: true;
        input-type: root.secret ? InputType.password : InputType.text;
        accepted => { root.accepted(); }
    }
}
// One row of the message menu: an outline icon (24-unit path) and a label, as in Telegram.
component MenuRow inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> enabled: true;
    callback clicked();
    height: 38px;
    background: touch.has-hover && root.enabled ? Theme.menu-hover : transparent;
    Path {
        x: 16px; y: (parent.height - 20px) / 2; width: 20px; height: 20px;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.icon; fill: transparent;
        stroke: root.enabled ? Theme.menu-icon : Theme.muted; stroke-width: 1.6px;
    }
    Text {
        x: 52px; width: parent.width - 64px; height: parent.height; text: root.text; font-size: Theme.type-body;
        vertical-alignment: center;
        color: root.enabled ? Theme.text : Theme.muted;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}
component Avatar inherits Rectangle {
    in property <image> source;
    in property <string> initials;
    in property <color> tint;
    border-radius: self.width / 2;
    clip: true;
    background: root.tint;
    Text { text: root.initials; color: Theme.on-strong; horizontal-alignment: center; vertical-alignment: center; font-size: root.width * 0.36; font-weight: 600; }
    Image { source: root.source; width: parent.width; height: parent.height; image-fit: cover; }
}
export component AppWindow inherits Window {
    in property <string> window-title: "Veygram";
    title: root.window-title;
    icon: @image-url("icon.png");
    in property <string> open-unread;
    preferred-width: 1040px;
    preferred-height: 740px;
    min-width: 700px;
    min-height: 520px;
    background: Theme.window;
    default-font-family: "Segoe UI";
    in property <bool> ready;
    in property <bool> demo;
    in property <bool> blocked;
    in-out property <bool> security-warning;
    in property <string> error;
    in property <string> auth-title: "Starting Telegram";
    // 0 connecting, 1 QR, 2 phone, 3 code, 4 password.
    in-out property <int> auth-step;
    in property <image> qr;
    in property <[ChatRow]> chats;
    in property <[MessageRow]> messages;
    in property <image> chat-avatar;
    in property <string> chat-initials;
    in property <color> chat-color: Theme.avatar-fallback;
    in property <string> chat-title: "";
    in property <bool> chat-open;
    in property <bool> more-chats: true;
    in-out property <length> feed-y;
    in property <length> feed-content-height;
    in-out property <length> feed-height: 500px;
    in-out property <length> chat-y;
    in-out property <length> chat-height: 600px;
    // Row height matches CHAT_ROW in models.rs.
    out property <bool> chat-near-end: root.chats.length * 62px + root.chat-y < root.chat-height * 3;
    in property <bool> at-newest: true;
    in-out property <length> feed-left;
    in-out property <length> feed-top;
    in-out property <length> feed-view-width;
    callback viewport-changed();
    callback wheel(delta: length);
    callback chat-viewport-changed();
    callback media-ready();
    pure callback text-link(key: string, x: length, y: length) -> string;
    callback text-link-clicked(key: string, x: length, y: length);
    changed chat-y => { root.chat-viewport-changed(); }
    changed chat-height => { root.chat-viewport-changed(); }
    in-out property <string> auth-input;
    in-out property <string> draft;
    // Maximum bubble width: the history area minus side margins, at most 504 px.
    out property <length> feed-width: max(80px, min(504px, root.width - 300px - 48px));
    changed feed-width => { root.width-changed(); }
    callback width-changed();
    callback drain-events();
    callback auth-submit();
    callback request-qr();
    callback local-retry();
    callback local-reset();
    callback open-chat(index: int);
    // Opens the video of a feed cell in the separate media viewer window.
    callback open-video(row: int, cell: int);
    callback attachment-action(key: string, action: int, fraction: float);
    // Interface scale dialog (action-dialog 4). `scale-applied` is the stored value, 0 = auto.
    in-out property <int> scale-percent: 100;
    in-out property <bool> scale-auto: true;
    in property <int> scale-system: 100;
    in property <int> scale-applied;
    callback open-scale();
    callback apply-scale(value: int);
    in property <bool> round-floating;
    in property <length> round-x;
    in property <length> round-y;
    in property <length> round-size;
    in property <image> round-preview;
    in property <image> round-frame;
    in property <bool> round-expanded;
    out property <float> round-growth: root.round-expanded ? 1 : 0;
    animate round-growth { duration: 200ms; easing: ease-in-out; }
    changed round-growth => { root.round-scale(root.round-growth); }
    callback round-scale(float);
    in property <string> round-key;
    in property <string> round-time;
    in property <string> round-arc;
    callback round-pointer(phase: int, x: float, y: float);
    callback round-return();
    callback confirm-file();
    in property <string> file-name;
    callback confirm-link();
    in property <string> link-target;

    callback load-chats();
    callback send();
    callback attach-file();
    callback paste-image() -> bool;
    callback outgoing-ready();
    callback cancel-outgoing();
    callback send-outgoing();
    in property <bool> attachment-busy;
    in property <bool> outgoing-open;
    in property <bool> outgoing-photo;
    in property <bool> outgoing-has-preview;
    in property <image> outgoing-preview;
    in property <string> outgoing-name;
    in property <string> outgoing-size;
    in-out property <string> outgoing-caption;
    in-out property <bool> outgoing-as-file;
    callback logout();
    callback demo-toggle();
    callback clear-highlight();
    in-out property <bool> composer-focus;
    public function focus-composer() { root.composer-focus = !root.composer-focus; }
    callback latest();
    // Action IDs: 0 reply, 1 edit, 2 copy, 3 forward, 4 delete, 5 open quote.
    callback message-action(key: string, action: int);
    // Toggles a reaction on the row's message; the engine adds or removes it.
    callback react(key: string, reaction: string);
    // Fills `quick-reactions` and `menu-can-react` for the row whose menu opens.
    callback menu-opened(key: string);
    in property <[QuickReaction]> quick-reactions;
    in-out property <bool> menu-can-react;
    // In-window message menu (see the comment at the message bubble).
    in-out property <bool> menu-open;
    changed menu-open => { root.viewport-changed(); }
    in-out property <length> menu-x;
    in-out property <length> menu-y;
    in-out property <string> menu-key;
    in-out property <bool> menu-can-reply;
    in-out property <bool> menu-can-edit;
    in-out property <bool> menu-can-forward;
    in-out property <bool> menu-can-delete;
    in-out property <bool> menu-can-reveal;
    function open-menu(key: string, reply: bool, edit: bool, forward: bool, delete: bool, reveal: bool, x: length, y: length) {
        root.menu-key = key;
        root.menu-can-reply = reply;
        root.menu-can-edit = edit;
        root.menu-can-forward = forward;
        root.menu-can-delete = delete;
        root.menu-can-reveal = reveal;
        root.menu-x = x;
        root.menu-y = y;
        root.menu-can-react = false;
        root.menu-opened(key);
        root.menu-open = true;
    }
    function menu-pick(action: int) {
        root.menu-open = false;
        root.message-action(root.menu-key, action);
    }
    callback cancel-action();
    callback confirm-delete();
    callback forward-to(index: int);
    callback filter-destinations(query: string);
    in property <[ChatRow]> destinations;
    in-out property <string> forward-query;
    changed forward-query => { root.filter-destinations(root.forward-query); }
    in property <string> composer-title;
    in property <string> composer-preview;
    in property <bool> editing;
    in property <bool> edit-saving;
    in-out property <length> destination-y;
    changed destination-y => { root.chat-viewport-changed(); }
    // 0 closed, 1 delete, 2 forward, 3 open file, 4 interface scale, 5 open link.
    in-out property <int> action-dialog;
    changed action-dialog => { root.viewport-changed(); }
    in property <bool> can-revoke;
    in property <bool> must-revoke;
    in-out property <bool> revoke;
    public function copy-text(value: string) {
        clipboard.text = value; clipboard.select-all(); clipboard.copy(); clipboard.text = "";
    }
    clipboard := TextInput { visible: false; }
    in-out property <bool> follow-tail: true;
    VerticalLayout {
        padding: 0px; spacing: 0px;
        if root.demo: Rectangle {
            height: 40px; background: Theme.panel;
            HorizontalLayout { padding: 4px; padding-left: 14px; spacing: 10px;
                Text { min-width: 300px; horizontal-stretch: 1; text: "DEMO / Synthetic data / no account or key files"; color: Theme.accent; font-size: Theme.type-meta; vertical-alignment: center; }
                Link { width: 140px; text: root.ready ? "Preview sign-in" : "Back to chats"; clicked => { root.demo-toggle(); } }
                Link { width: 120px; text: "TPM warning"; clicked => { root.security-warning = !root.security-warning; } }
            }
        }
        if root.security-warning: Rectangle {
            height: 40px; background: Theme.warning-surface;
            Text { x: 16px; width: parent.width - 32px; text: "Security warning: TPM unavailable. The database key is protected by Windows DPAPI only."; color: Theme.warning-text; font-size: Theme.type-small; wrap: word-wrap; vertical-alignment: center; }
        }
        if root.error != "": Rectangle {
            height: 40px; background: Theme.error-surface;
            Text { x: 16px; width: parent.width - 32px; text: root.error; color: Theme.error-text; font-size: Theme.type-small; wrap: word-wrap; vertical-alignment: center; }
        }
        if !root.ready: Rectangle {
            background: Theme.window;
            VerticalLayout {
                alignment: center; padding: 50px; spacing: 16px;
                HorizontalLayout { alignment: center;
                    Image { width: 112px; height: 112px; source: @image-url("icon.png"); image-fit: contain; }
                }
                Text { text: root.auth-step == 2 ? "Sign in to Telegram" : root.auth-title; color: Theme.text; font-size: Theme.type-display; font-weight: 600; horizontal-alignment: center; }
                if root.auth-step == 1: VerticalLayout {
                    alignment: center; spacing: 14px;
                    HorizontalLayout { alignment: center;
                        Rectangle { width: 232px; height: 232px; background: Theme.qr-paper; border-radius: Theme.radius-bubble; Image { x: 6px; y: 6px; width: 220px; height: 220px; source: root.qr; image-fit: contain; } }
                    }
                    Text { text: "Open Telegram on your phone, go to Settings > Devices > Link Desktop Device and scan this code."; color: Theme.muted; font-size: Theme.type-body; horizontal-alignment: center; wrap: word-wrap; }
                }
                // 5: the local database key cannot be unlocked (TPM or DPAPI refused it).
                if root.auth-step == 5: HorizontalLayout { alignment: center;
                    VerticalLayout {
                        width: 400px; spacing: 12px;
                        Text {
                            text: "Veygram cannot unlock its local data on this computer: Windows refused the key that protects it. Your account is safe, and your chats are stored on Telegram's servers.";
                            color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; horizontal-alignment: center;
                        }
                        Text {
                            text: "Start fresh to sign in again with a new key. The old data is moved to a backup folder next to it; nothing is deleted.";
                            color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; horizontal-alignment: center;
                        }
                        Action { text: "START FRESH"; enabled: !root.blocked; clicked => { root.local-reset(); } }
                        Link { text: "Try again"; enabled: !root.blocked; clicked => { root.local-retry(); } }
                    }
                }
                if root.auth-step >= 2 && root.auth-step <= 4: HorizontalLayout { alignment: center;
                    VerticalLayout {
                        width: 340px; spacing: 12px;
                        Text { text: root.auth-step == 2 ? "Please confirm your country code and enter your phone number." : root.auth-step == 3 ? "Enter the code Telegram sent you." : "Your account is protected with an additional password."; color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; horizontal-alignment: center; }
                        Input { text <=> root.auth-input; secret: root.auth-step == 4; accepted => { if !root.blocked { root.auth-submit(); } } }
                        Action { text: "NEXT"; enabled: !root.blocked && root.auth-input != ""; clicked => { root.auth-submit(); } }
                        Link { text: "Log in by QR code"; enabled: !root.blocked; clicked => { root.auth-input = ""; root.request-qr(); } }
                    }
                }
            }
        }
        if root.ready: HorizontalLayout {
            spacing: 0px; padding: 0px;
            Rectangle {
                width: 300px; background: Theme.panel;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    Rectangle { height: 54px; background: Theme.panel;
                        menu-button := Rectangle {
                            x: 10px; y: 9px; width: 36px; height: 36px; border-radius: self.height / 2;
                            background: menu-touch.has-hover ? Theme.hover : transparent;
                            Path { x: 9px; y: 11px; width: 18px; height: 14px; viewbox-width: 18; viewbox-height: 14;
                                stroke: Theme.muted; stroke-width: 2px; fill: transparent;
                                commands: "M0 1 L18 1 M0 7 L18 7 M0 13 L18 13"; }
                            menu-touch := TouchArea { clicked => { menu.show(); } }
                        }
                        Text { x: 58px; text: "Chats"; color: Theme.text; font-size: Theme.type-heading; font-weight: 600; vertical-alignment: center; height: parent.height; }
                        menu := PopupWindow {
                            x: 10px; y: 48px; width: 200px; height: 92px;
                            Rectangle { background: Theme.menu; border-radius: Theme.radius-panel; drop-shadow-blur: 12px; drop-shadow-color: Theme.shadow;
                                Rectangle { x: 0px; y: 6px; width: parent.width; height: 40px;
                                    background: scale-touch.has-hover ? Theme.menu-hover : transparent;
                                    Text { x: 16px; text: "Interface scale"; color: Theme.text; font-size: Theme.type-body; vertical-alignment: center; height: parent.height; }
                                    scale-touch := TouchArea { enabled: !root.blocked; clicked => { root.open-scale(); } }
                                }
                                Rectangle { x: 0px; y: 46px; width: parent.width; height: 40px;
                                    background: logout-touch.has-hover ? Theme.menu-hover : transparent;
                                    Text { x: 16px; text: "Log out"; color: root.demo ? Theme.muted : Theme.text; font-size: Theme.type-body; vertical-alignment: center; height: parent.height; }
                                    logout-touch := TouchArea { enabled: !root.blocked && !root.demo; clicked => { root.logout(); } }
                                }
                            }
                        }
                    }
                    chat-list := ListView {
                        changed visible-height => { root.chat-height = self.visible-height; }
                        // Bound to the position itself, so the wheel animation updates it on every
                        // frame; `scrolled` fires only for the input event that started it.
                        content-y <=> root.chat-y;
                        scrolled => { if root.chat-near-end && root.more-chats { root.load-chats(); } }
                        in property <int> chat-count: root.chats.length;
                        changed chat-count => { if root.chat-near-end && root.more-chats { root.load-chats(); } }
                        for chat[index] in root.chats: Rectangle {
                            height: 62px;
                            background: chat.selected ? Theme.selected : row-touch.has-hover ? Theme.hover : Theme.panel;
                            Avatar { x: 10px; y: 8px; width: 46px; height: 46px; source: chat.avatar; initials: chat.initials; tint: chat.color; }
                            Text { x: 68px; y: 9px; width: parent.width - 68px - 62px; height: 20px; text: chat.title; color: Theme.text; font-size: Theme.type-body; font-weight: 600; overflow: elide; }
                            Text { x: parent.width - 60px; y: 10px; width: 50px; height: 18px; text: chat.time; color: chat.selected ? Theme.on-strong-3 : Theme.muted; font-size: Theme.type-meta; horizontal-alignment: right; }
                            Text { x: 68px; y: 32px; width: parent.width - 68px - (chat.unread != "" || chat.mentions != "" ? 90px : 12px); height: 20px; text: chat.preview; color: chat.selected ? Theme.on-strong-2 : Theme.muted; font-size: Theme.type-small; overflow: elide; }
                            if chat.unread != "" || chat.mentions != "": Rectangle {
                                height: 20px; width: max(20px, badge-text.preferred-width + 12px);
                                x: parent.width - self.width - 10px; y: 33px; border-radius: self.height / 2;
                                background: chat.muted ? Theme.badge-muted : chat.selected ? Theme.on-strong : Theme.badge;
                                badge-text := Text { text: chat.mentions != "" ? "@" + chat.mentions + (chat.unread != "" ? " / " + chat.unread : "") : chat.unread; color: chat.selected ? Theme.selected : Theme.on-strong; font-size: Theme.type-meta; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            row-touch := TouchArea { enabled: !root.blocked; clicked => { root.open-chat(index); } }
                        }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.border; }
            Rectangle {
                background: Theme.window;
                VerticalLayout {
                    padding: 0px; spacing: 0px;
                    if root.chat-open: Rectangle { height: 54px; background: Theme.panel;
                        Avatar { x: 14px; y: 8px; width: 38px; height: 38px; source: root.chat-avatar; initials: root.chat-initials; tint: root.chat-color; }
                        Text { x: 64px; width: parent.width - 80px; height: parent.height; text: root.chat-title; color: Theme.text; font-size: Theme.type-title; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
                    }
                    feed-area := Rectangle {
                        clip: true;
                        property <length> location-x: self.absolute-position.x;
                        property <length> location-y: self.absolute-position.y;
                        // `changed` handlers do not publish an unchanged initial value: without
                        // this, a feed created in place kept feed-left and the viewport width at 0,
                        // which clipped the native round to nothing and mispositioned clicks.
                        init => {
                            root.feed-left = self.location-x;
                            root.feed-top = self.location-y;
                            root.feed-view-width = self.width;
                            root.feed-height = self.height;
                            root.viewport-changed();
                        }
                        changed location-x => { root.feed-left=self.location-x; root.viewport-changed(); }
                        changed location-y => { root.feed-top=self.location-y; root.viewport-changed(); }
                        changed width => { root.feed-view-width=self.width; root.viewport-changed(); }
                        changed height => { root.feed-height = self.height; root.viewport-changed(); }
                        wheel-area := TouchArea {
                            width: parent.width; height: parent.height;
                            scroll-event(event) => {
                                if root.blocked { return reject; }
                                root.wheel(event.delta-y);
                                return accept;
                            }
                        feed := Flickable {
                            width: parent.width; height: parent.height;
                            content-width: self.width;
                            content-height: max(self.height, root.feed-content-height);
                            content-y <=> root.feed-y;
                            // Wheel and touchpad scrolling run in Rust (see State::wheel): Slint's
                            // own wheel animation keeps its old target when a page is prepended.
                            interactive: false;
                            changed content-y => { root.viewport-changed(); }
                            for msg[row] in root.messages: Rectangle {
                                // Rows sit at the bottom when the history is shorter than the view.
                                y: msg.row-y + max(0px, feed.height - root.feed-content-height);
                                width: feed.width; height: msg.height;
                                if msg.date != "": Rectangle {
                                    y: 10px; height: 24px; width: date-text.preferred-width + 22px;
                                    x: (parent.width - self.width) / 2; border-radius: Theme.radius-bubble; background: Theme.date;
                                    date-text := Text { text: msg.date; color: Theme.text; font-size: Theme.type-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if msg.unread: Rectangle { y: msg.unread-y; width: parent.width; height: 30px; background: Theme.panel;
                                    Text { text: "Unread messages"; color: Theme.accent; font-size: Theme.type-small; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if msg.service: Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: msg.bubble-y; width: msg.bubble-width; height: msg.bubble-height;
                                    border-radius: min(Theme.radius-bubble, self.height / 2); background: Theme.date;
                                    MessageText {
                                        x: (parent.width - self.width) / 2; y: msg.text-y;
                                        width: msg.text-width; height: msg.text-height; source: msg.rendered;
                                        enabled: !root.blocked && root.action-dialog == 0;
                                        target-at(x, y) => { root.text-link(msg.key, x, y) }
                                        activate(x, y) => { root.text-link-clicked(msg.key, x, y); }
                                    }
                                }
                                Rectangle {
                                    visible: !msg.service;
                                    x: msg.outgoing ? parent.width - msg.bubble-width - 14px : 14px;
                                    y: msg.bubble-y; width: msg.bubble-width; height: msg.bubble-height;
                                    background: msg.highlighted ? Theme.highlight : msg.sticker ? transparent : msg.outgoing ? Theme.outgoing : Theme.incoming;
                                    border-top-left-radius: Theme.radius-bubble; border-top-right-radius: Theme.radius-bubble;
                                    border-bottom-left-radius: !msg.outgoing && msg.tail ? Theme.radius-small : Theme.radius-bubble;
                                    border-bottom-right-radius: msg.outgoing && msg.tail ? Theme.radius-small : Theme.radius-bubble;
                                    TouchArea {
                                        enabled: !root.blocked && root.action-dialog == 0;
                                        pointer-event(event) => {
                                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                root.open-menu(msg.key, msg.can-reply, msg.can-edit, msg.can-forward, msg.can-delete, msg.file-available,
                                                    self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                    }
                                    if msg.forwarded != "": Text {
                                        x: 10px; y: 6px; height: 18px; width: parent.width - 20px;
                                        text: msg.forwarded; color: Theme.accent; font-size: Theme.type-small; overflow: elide;
                                    }
                                    if msg.has-quote: Rectangle {
                                        x: 10px; y: msg.quote-y; width: parent.width - 20px; height: 40px;
                                        background: Theme.accent-wash; border-radius: Theme.radius-small;
                                        Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: msg.quote-color; }
                                        Text { x: 9px; y: 2px; width: parent.width - 18px; height: 17px; text: msg.quote-sender; color: msg.quote-color; font-size: Theme.type-small; font-weight: 600; overflow: elide; }
                                        Text { x: 9px; y: 20px; width: parent.width - 18px; height: 17px; text: msg.quote-preview; color: Theme.text; font-size: Theme.type-small; overflow: elide; }
                                        TouchArea { clicked => { root.message-action(msg.key, 5); } }
                                    }
                                    if msg.sender != "": Text {
                                        x: 10px; y: msg.sender-y; width: parent.width - 20px; height: 18px;
                                        text: msg.sender; color: msg.sender-color; font-size: Theme.type-small; font-weight: 600; overflow: elide;
                                    }
                                    if msg.voice || msg.document: Rectangle {
                                        x: 10px; y: msg.attachment-y; height: 64px; width: parent.width - 20px;
                                        Rectangle {
                                            x: 0px; y: 7px; width: 44px; height: 44px; border-radius: self.height / 2; background: Theme.badge;
                                            if msg.file-progress == "" && msg.voice: Path {
                                                x: 15px; y: 13px; width: 16px; height: 18px; viewbox-width: 16; viewbox-height: 18;
                                                fill: Theme.on-strong; commands: msg.voice-playing ? "M1 1 H6 V17 H1 Z M10 1 H15 V17 H10 Z" : "M2 1 L15 9 L2 17 Z";
                                            }
                                            if msg.file-progress == "" && msg.document: Path {
                                                x: 12px; y: 10px; width: 20px; height: 24px; viewbox-width: 20; viewbox-height: 24;
                                                stroke: Theme.on-strong; stroke-width: 1.5px; fill: transparent;
                                                commands: msg.file-available ? "M3 1 H12 L18 7 V23 H3 Z M12 1 V7 H18 M6 13 H15 M6 17 H13" : "M10 2 V17 M4 11 L10 17 L16 11 M3 21 H17";
                                            }
                                            if msg.document: Image { width: 44px; height: 44px; source: msg.attachment-image; image-fit: cover; }
                                            if msg.file-progress != "": Text { text: msg.file-progress; color: Theme.on-strong; font-size: Theme.type-caption; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        if msg.voice: Rectangle {
                                            x: 56px; y: 12px; width: parent.width - 56px; height: 28px;
                                            for bar[index] in msg.waveform: Rectangle {
                                                x: index * parent.width / 48; width: max(1px, parent.width / 48 - 2px);
                                                height: bar.amplitude; y: (parent.height - self.height) / 2;
                                                border-radius: self.width / 2; background: bar.played ? Theme.accent : Theme.muted;
                                            }
                                            TouchArea { clicked => { root.attachment-action(msg.key, 1, self.mouse-x / self.width); } }
                                        }
                                        if msg.voice: Text { x: 56px; y: 43px; width: parent.width - 70px; height: 18px; text: msg.voice-time; color: Theme.muted; font-size: Theme.type-meta; }
                                        if msg.voice && msg.voice-unlistened: Rectangle { x: parent.width - 7px; y: 48px; width: 5px; height: 5px; border-radius: self.height / 2; background: Theme.accent; }
                                        if msg.document: Text { x: 56px; y: 9px; width: parent.width - 62px; height: 22px; text: msg.file-name; color: Theme.text; font-size: Theme.type-body; font-weight: 600; overflow: elide; }
                                        if msg.document: Text { x: 56px; y: 34px; width: parent.width - 62px; height: 20px; text: msg.file-size + (msg.file-downloading ? " / downloading" : msg.file-available ? " / Open file" : " / Download"); color: Theme.muted; font-size: Theme.type-meta; overflow: elide; }
                                        // Explicit position: Slint centres an element that has a size but
                                        // no x, which put the voice play button's area over the waveform.
                                        TouchArea {
                                            x: 0px; y: 0px;
                                            width: msg.voice ? 48px : parent.width; height: parent.height;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.attachment-action(msg.key, 0, 0); }
                                            pointer-event(event) => {
                                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.up {
                                                    root.open-menu(msg.key,msg.can-reply,msg.can-edit,msg.can-forward,msg.can-delete,msg.file-available,
                                                        self.absolute-position.x+self.mouse-x,self.absolute-position.y+self.mouse-y);
                                                }
                                            }
                                        }
                                    }
                                    if msg.media-height > 0px: Rectangle {
                                        x: 0px; y: msg.media-y; width: msg.media-width; height: msg.media-height; clip: true;
                                        border-top-left-radius: msg.round ? self.width / 2 : msg.media-y == 0px ? Theme.radius-bubble : 0px;
                                        border-top-right-radius: msg.round ? self.width / 2 : msg.media-y == 0px ? Theme.radius-bubble : 0px;
                                        border-bottom-left-radius: msg.round ? self.width / 2 : msg.media-caption ? 0px : !msg.outgoing && msg.tail ? Theme.radius-small : Theme.radius-bubble;
                                        border-bottom-right-radius: msg.round ? self.width / 2 : msg.media-caption ? 0px : msg.outgoing && msg.tail ? Theme.radius-small : Theme.radius-bubble;
                                        for cell[index] in msg.cells: Rectangle {
                                            x: cell.x; y: cell.y; width: cell.width; height: cell.height; background: msg.sticker ? transparent : Theme.field;
                                            Text { text: cell.label; color: Theme.muted; font-size: msg.sticker ? 80px : 13px; horizontal-alignment: center; vertical-alignment: center; }
                                            Image { source: msg.round && msg.key == root.round-key && root.round-frame.width > 0 ? root.round-frame : cell.image; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; width: cell.raster-width > 0px ? cell.raster-width : parent.width; height: cell.raster-height > 0px ? cell.raster-height : parent.height; image-fit: msg.emoji ? contain : cover; }
                                            if cell.video || (msg.round && (!msg.round-active || !msg.voice-playing)): Rectangle {
                                                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                width: 48px; height: 48px; border-radius: self.height / 2; background: play-touch.has-hover ? Theme.scrim-hover : Theme.scrim;
                                                Path { x: 18px; y: 14px; width: 16px; height: 20px; viewbox-width: 16; viewbox-height: 20; fill: Theme.on-strong; commands: msg.round && msg.voice-playing ? "M0 0 H5 V20 H0 Z M11 0 H16 V20 H11 Z" : "M0 0 L16 10 L0 20 Z"; }
                                            }
                                            if cell.video && cell.duration != "": Rectangle {
                                                x: 8px; y: 8px; height: 20px; width: duration-text.preferred-width + 14px; border-radius: self.height / 2; background: Theme.scrim;
                                                duration-text := Text { text: cell.duration; color: Theme.on-strong; font-size: Theme.type-meta; horizontal-alignment: center; vertical-alignment: center; }
                                            }
                                            play-touch := TouchArea {
                                                enabled: !root.blocked;
                                                pointer-event(event) => {
                                                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.up && root.action-dialog == 0 {
                                                        root.open-menu(msg.key, msg.can-reply, msg.can-edit, msg.can-forward, msg.can-delete, msg.file-available,
                                                            self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                                    }
                                                }
                                                mouse-cursor: cell.video || msg.round ? MouseCursor.pointer : MouseCursor.default;
                                                clicked => { if msg.round { root.attachment-action(msg.key,0,0); } else if cell.video { root.open-video(row, index); } }
                                            }
                                        }
                                    }
                                    if msg.round: Rectangle {
                                        x: 6px; y: msg.media-y + msg.media-height + 4px; height: 20px;
                                        width: round-time.preferred-width + (msg.voice-unlistened ? 26px : 16px);
                                        border-radius: self.height / 2; background: Theme.scrim;
                                        round-time := Text { x: 8px; text: msg.file-progress != "" ? msg.file-progress : msg.voice-time;
                                            height: parent.height; color: Theme.on-strong; font-size: Theme.type-meta; vertical-alignment: center; }
                                        if msg.voice-unlistened: Rectangle { x: parent.width - 12px; y: 8px; width: 5px; height: 5px; border-radius: self.height / 2; background: Theme.on-strong; }
                                    }
                                    if msg.round && (msg.file-downloading || msg.round-active): Path {
                                        x: msg.round-active ? -2px : 0px; y: msg.media-y - (msg.round-active ? 2px : 0px);
                                        width: msg.media-width + (msg.round-active ? 4px : 0px); height: msg.media-height + (msg.round-active ? 4px : 0px);
                                        viewbox-width: 100; viewbox-height: 100; fill: transparent; stroke: Theme.accent; stroke-width: 1.5px;
                                        commands: msg.round-progress;
                                    }
                                    if msg.text-height > 0px: MessageText {
                                        x: 10px; y: msg.text-y; width: msg.text-width; height: msg.text-height; source: msg.rendered;
                                        enabled: !root.blocked && root.action-dialog == 0;
                                        target-at(x, y) => { root.text-link(msg.key, x, y) }
                                        activate(x, y) => { root.text-link-clicked(msg.key, x, y); }
                                        context-menu(x, y) => {
                                            root.open-menu(msg.key, msg.can-reply, msg.can-edit, msg.can-forward, msg.can-delete, msg.file-available, x, y);
                                        }
                                    }
                                    for chip in msg.reactions: Rectangle {
                                        x: 10px + chip.x; y: msg.reactions-y + chip.y; width: chip.width; height: 26px;
                                        border-radius: self.height / 2;
                                        background: chip.chosen ? Theme.accent
                                            : msg.sticker ? Theme.date
                                            : msg.outgoing ? (chip-touch.has-hover ? Theme.reaction-out-hover : Theme.reaction-out)
                                            : (chip-touch.has-hover ? Theme.reaction-in-hover : Theme.reaction-in);
                                        Image { x: 8px; y: 4px; width: 18px; height: 18px; source: chip.emoji; image-fit: contain; }
                                        Text {
                                            x: 30px; width: parent.width - 38px; height: parent.height; text: chip.count;
                                            font-size: Theme.type-meta; font-weight: 600; vertical-alignment: center;
                                            color: chip.chosen ? (msg.outgoing ? Theme.outgoing : Theme.incoming)
                                                : msg.outgoing ? Theme.reaction-out-text : msg.sticker ? Theme.text : Theme.accent;
                                        }
                                        chip-touch := TouchArea {
                                            enabled: msg.can-react && !root.blocked && root.action-dialog == 0;
                                            mouse-cursor: MouseCursor.pointer;
                                            clicked => { root.react(msg.key, chip.reaction); }
                                        }
                                    }
                                    if msg.time-over-media: Rectangle {
                                        x: msg.time-x - 6px; y: msg.time-y - 2px; height: 18px; border-radius: self.height / 2; background: Theme.scrim;
                                        width: msg.time-label-width + (msg.checks != 0 ? 18px : 0px) + 12px;
                                    }
                                    Text {
                                        x: msg.time-x; y: msg.time-y; width: msg.time-label-width; height: 14px; text: msg.time; font-size: Theme.type-meta;
                                        horizontal-alignment: right; vertical-alignment: center;
                                        color: msg.time-over-media ? Theme.on-strong : msg.outgoing ? Theme.time-out : Theme.time-in;
                                    }
                                    if msg.checks > 0: Path {
                                        x: msg.time-x + msg.time-label-width + 3px; y: msg.time-y + 2px; width: 15px; height: 10px;
                                        viewbox-width: 15; viewbox-height: 10; fill: transparent; stroke-width: 1.5px;
                                        stroke: msg.time-over-media ? Theme.on-strong : Theme.check;
                                        commands: msg.checks == 2 ? "M0.5 5 L4 8.5 L10.5 1.5 M6 7.5 L7 8.5 L14 1.5" : "M2.5 5 L6 8.5 L12.5 1.5";
                                    }
                                    if msg.checks == -1: Path {
                                        x: msg.time-x + msg.time-label-width + 4px; y: msg.time-y + 1px; width: 12px; height: 12px;
                                        viewbox-width: 12; viewbox-height: 12; fill: transparent; stroke-width: 1.2px;
                                        stroke: msg.time-over-media ? Theme.on-strong : Theme.time-out;
                                        commands: "M6 0.8 A5.2 5.2 0 1 0 6.01 0.8 M6 3 L6 6 L8 7.2";
                                    }
                                    if msg.checks == -2: Rectangle {
                                        x: msg.time-x + msg.time-label-width + 4px; y: msg.time-y; width: 14px; height: 14px; border-radius: self.height / 2; background: Theme.danger;
                                        Text { text: "!"; color: Theme.on-strong; font-size: Theme.type-caption; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                        }
                        if !root.chat-open: Rectangle {
                            width: empty-text.preferred-width + 28px; height: 28px; border-radius: self.height / 2; background: Theme.date;
                            empty-text := Text { text: "Select a chat to start messaging"; color: Theme.text; font-size: Theme.type-small; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        if root.chat-open && (!root.follow-tail || !root.at-newest): Rectangle {
                            x: parent.width - 62px; y: parent.height - 62px; width: 46px; height: 46px; border-radius: self.height / 2;
                            background: down-touch.has-hover ? Theme.hover : Theme.panel;
                            drop-shadow-blur: 6px; drop-shadow-color: Theme.shadow;
                            Path { x: 15px; y: 18px; width: 16px; height: 10px; viewbox-width: 16; viewbox-height: 10;
                                stroke: Theme.muted; stroke-width: 2px; fill: transparent; commands: "M1 1 L8 8 L15 1"; }
                            if root.open-unread != "": Rectangle { x: -3px; y: -12px; height: 22px; min-width: 26px; width: max(26px, unread-label.preferred-width + 12px); border-radius: self.height / 2; background: Theme.badge;
                                unread-label := Text { text: root.open-unread; color: Theme.on-strong; font-size: Theme.type-meta; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            down-touch := TouchArea { enabled: !root.blocked; clicked => { root.latest(); } }
                        }
                    }
                    if root.chat-open && root.composer-title != "": Rectangle {
                        height: 50px; background: Theme.panel;
                        Rectangle { x: 16px; y: 6px; width: 3px; height: 38px; background: Theme.accent; }
                        Text { x: 27px; y: 6px; height: 18px; width: parent.width - 80px; text: root.composer-title; color: Theme.accent; font-size: Theme.type-small; font-weight: 600; overflow: elide; }
                        Text { x: 27px; y: 25px; height: 18px; width: parent.width - 80px; text: root.composer-preview; color: Theme.muted; font-size: Theme.type-small; overflow: elide; }
                        Link { x: parent.width - 72px; y: 8px; width: 64px; text: "Cancel"; clicked => { root.cancel-action(); } }
                    }
                    if root.chat-open: Rectangle {
                        height: max(52px, min(170px, composer.preferred-height + 30px)); background: Theme.panel;
                        Rectangle { height: 1px; y: 0px; background: Theme.border; }
                        composer := TextInput {
                            in property <bool> focus-request: root.composer-focus;
                            changed focus-request => { self.focus(); }
                            x: 54px; y: 15px; width: parent.width - 54px - 60px; height: parent.height - 30px;
                            text <=> root.draft; color: Theme.text; font-size: Theme.type-body; wrap: word-wrap;
                            selection-background-color: Theme.selected; selection-foreground-color: Theme.on-strong;
                            enabled: !root.blocked;
                            key-pressed(event) => {
                                if event.modifiers.control && (event.text == "v" || event.text == "V") && root.paste-image() { return accept; }
                                if event.text == Key.Escape { root.cancel-action(); return accept; }
                                if event.text == Key.Return && !event.modifiers.shift { root.send(); return accept; }
                                return reject;
                            }
                        }
                        Rectangle {
                            x: 6px; y: parent.height - 46px; width: 40px; height: 40px; border-radius: 20px;
                            background: attach-touch.has-hover ? Theme.hover : transparent;
                            Path { x: 9px; y: 8px; width: 22px; height: 24px; viewbox-width: 24; viewbox-height: 24;
                                fill: transparent; stroke: root.attachment-busy || root.editing ? Theme.icon-idle : Theme.muted; stroke-width: 1.8px;
                                commands: "M8 13 L15 6 C18 3 22 7 19 10 L10 19 C5 24 -1 18 4 13 L13 4 M7 16 L16 7"; }
                            attach-touch := TouchArea { enabled: !root.blocked && !root.editing && !root.attachment-busy; clicked => { root.attach-file(); } }
                        }
                        if root.draft == "": Text { x: 54px; y: 15px; height: 20px; text: "Write a message..."; color: Theme.muted; font-size: Theme.type-body; }
                        Rectangle {
                            x: parent.width - 52px; y: parent.height - 46px; width: 40px; height: 40px; border-radius: self.height / 2;
                            background: send-touch.has-hover && root.draft != "" ? Theme.hover : transparent;
                            Path { x: 9px; y: 10px; width: 22px; height: 20px; viewbox-width: 24; viewbox-height: 20;
                                fill: root.draft != "" ? Theme.accent : Theme.icon-idle;
                                commands: "M1 9 L22 1 L18 19 L12 14 L9 18 L8 12 L18 4 L7 11 Z"; }
                            send-touch := TouchArea { enabled: !root.blocked && !root.edit-saving && root.draft != ""; clicked => { root.send(); } }
                        }
                    }
                }
            }
        }
    }
    if root.round-floating: Rectangle {
        x: root.round-x - 4px; y: root.round-y - 4px;
        width: root.round-size + 8px; height: self.width;
        border-radius: self.width / 2;
        background: Theme.shadow;
        Rectangle {
            x: 4px; y: 4px; width: root.round-size; height: self.width;
            border-radius: self.width / 2; clip: true;
            background: Theme.field;
            Image { source: root.round-frame.width > 0 ? root.round-frame : root.round-preview; width: parent.width; height: parent.height; image-fit: cover; }
        }
        Path { width: parent.width; height: parent.height; viewbox-width: 100; viewbox-height: 100;
            fill: transparent; stroke: Theme.accent; stroke-width: 2px; commands: root.round-arc; }
        Rectangle {
            x: (parent.width - self.width)/2; y: parent.height + 2px;
            width: time.preferred-width + 12px; height: 20px; border-radius: self.height / 2;
            background: Theme.scrim;
            time := Text { text: root.round-time; color: Theme.on-strong; font-size: Theme.type-meta;
                horizontal-alignment: center; vertical-alignment: center; }
        }
        touch := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.round-pointer(0,(self.absolute-position.x+self.mouse-x)/1px,(self.absolute-position.y+self.mouse-y)/1px);
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.round-pointer(2,(self.absolute-position.x+self.mouse-x)/1px,(self.absolute-position.y+self.mouse-y)/1px);
                } else if event.kind == PointerEventKind.cancel { root.round-pointer(3,0,0); }
            }
            moved => { if self.pressed { root.round-pointer(1,(self.absolute-position.x+self.mouse-x)/1px,(self.absolute-position.y+self.mouse-y)/1px); } }
            double-clicked => { root.round-return(); }
            scroll-event(event) => { root.wheel(event.delta-y); return accept; }
        }
    }
    if root.action-dialog != 0: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.cancel-action(); return accept; }
                // Enter confirms the link dialog, as the default button does in Telegram Desktop.
                if root.action-dialog == 5 && event.text == Key.Return && !root.blocked && root.link-target != "" { root.confirm-link(); return accept; }
                return reject;
            }
        }
        Rectangle {
            width: 420px; height: root.action-dialog == 1 ? 220px : root.action-dialog == 3 || root.action-dialog == 5 ? 260px : root.action-dialog == 4 ? 250px : 440px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: Theme.radius-panel; background: Theme.panel;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: root.action-dialog == 1 ? "Delete message?" : root.action-dialog == 3 ? "Open this file?" : root.action-dialog == 4 ? "Interface scale" : root.action-dialog == 5 ? "Open this link?" : "Forward to"; color: Theme.text; font-size: Theme.type-dialog; font-weight: 600; }
                if root.action-dialog == 5: link-scroll := ScrollView {
                    horizontal-scrollbar-policy: always-off;
                    content-width: self.visible-width;
                    content-height: link-label.preferred-height;
                    link-label := Text {
                        x: 0px; y: 0px; width: link-scroll.visible-width - 16px;
                        height: self.preferred-height;
                        text: root.link-target; color: Theme.text; font-size: Theme.type-body; wrap: char-wrap;
                    }
                }
                if root.action-dialog == 4: Rectangle {
                    height: 38px;
                    Rectangle { x: 0px; y: 9px; width: 18px; height: 18px; border-radius: Theme.radius-small; border-width: 1px; border-color: Theme.accent; background: root.scale-auto ? Theme.badge : transparent;
                        if root.scale-auto: Path { x: 3px; y: 4px; width: 12px; height: 9px; viewbox-width: 12; viewbox-height: 9; fill: transparent; stroke: Theme.on-strong; stroke-width: 2px; commands: "M1 4 L4 7 L11 1"; }
                    }
                    Text { x: 28px; width: parent.width - 28px; text: "Default interface scale (" + root.scale-system + "%)"; color: Theme.text; font-size: Theme.type-body; overflow: elide; vertical-alignment: center; }
                    TouchArea { clicked => { root.scale-auto = !root.scale-auto; if root.scale-auto { root.scale-percent = root.scale-system; } } }
                }
                if root.action-dialog == 4: HorizontalLayout {
                    spacing: 12px; height: 24px;
                    ScaleSlider { value <=> root.scale-percent; edited => { root.scale-auto = false; } }
                    Text { width: 52px; text: root.scale-percent + "%"; color: Theme.text; font-size: Theme.type-body; horizontal-alignment: right; vertical-alignment: center; }
                }
                if root.action-dialog == 4: Text { text: "Veygram restarts to apply a new scale."; color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; }
                if root.action-dialog == 3: Text { text: "This file can run code on your computer. Open it only if you trust its source."; color: Theme.text; font-size: Theme.type-body; wrap: word-wrap; }
                if root.action-dialog == 3: Text { text: root.file-name; color: Theme.muted; font-size: Theme.type-body; overflow: elide; }
                if root.action-dialog == 1: Text { text: "Delete the selected message or entire album?"; color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; }
                if root.action-dialog == 1 && root.can-revoke: Rectangle {
                    height: 38px;
                    Rectangle { x: 0px; y: 9px; width: 18px; height: 18px; border-radius: Theme.radius-small; border-width: 1px; border-color: Theme.accent; background: root.revoke ? Theme.badge : transparent;
                        if root.revoke: Path { x: 3px; y: 4px; width: 12px; height: 9px; viewbox-width: 12; viewbox-height: 9; fill: transparent; stroke: Theme.on-strong; stroke-width: 2px; commands: "M1 4 L4 7 L11 1"; }
                    }
                    Text { x: 28px; width: parent.width - 28px; text: "Also delete for " + root.chat-title; color: Theme.text; font-size: Theme.type-body; overflow: elide; vertical-alignment: center; }
                    TouchArea { enabled: !root.must-revoke; clicked => { root.revoke = !root.revoke; } }
                }
                if root.action-dialog == 2: Input { text <=> root.forward-query; }
                if root.action-dialog == 2: ListView {
                    scrolled => { root.destination-y = self.content-y; }
                    for chat[index] in root.destinations: Rectangle {
                        height: 52px; background: dest-touch.has-hover ? Theme.hover : transparent;
                        Avatar { x: 4px; y: 5px; width: 40px; height: 40px; source: chat.avatar; initials: chat.initials; tint: chat.color; }
                        Text { x: 56px; width: parent.width - 62px; height: parent.height; text: chat.title; color: Theme.text; font-size: Theme.type-body; vertical-alignment: center; overflow: elide; }
                        dest-touch := TouchArea { clicked => { root.forward-to(index); } }
                    }
                }
                HorizontalLayout { alignment: end; spacing: 12px;
                    Link { text: "Cancel"; width: 100px; clicked => { root.cancel-action(); } }
                    if root.action-dialog == 3: Action { text: "Open"; width: 100px; clicked => { root.confirm-file(); } }
                    if root.action-dialog == 5: Action { text: "Open"; width: 100px; enabled: !root.blocked && root.link-target != ""; clicked => { root.confirm-link(); } }
                    if root.action-dialog == 1: Action { text: "Delete"; width: 100px; clicked => { root.confirm-delete(); } }
                    if root.action-dialog == 4: Action {
                        text: "Restart now"; width: 130px;
                        enabled: (root.scale-auto ? 0 : root.scale-percent) != root.scale-applied;
                        clicked => { root.apply-scale(root.scale-auto ? 0 : root.scale-percent); }
                    }
                }
            }
        }
    }


    if root.outgoing-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        FocusScope {
            width: parent.width; height: parent.height;
            init => { self.focus(); }
            capture-key-pressed(event) => {
                if event.text == Key.Escape { root.cancel-outgoing(); return accept; }
                return reject;
            }
        Rectangle {
            width: min(420px, root.width - 32px); height: root.outgoing-photo ? 530px : 300px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.panel; border-radius: Theme.radius-panel;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: root.outgoing-photo && !root.outgoing-as-file ? "Send photo" : "Send file"; color: Theme.text; font-size: Theme.type-dialog; font-weight: 600; }
                if root.outgoing-photo && root.outgoing-has-preview: Image { source: root.outgoing-preview; height: 200px; image-fit: contain; }
                if root.outgoing-photo && !root.outgoing-has-preview: Text { height: 200px; text: "Preview unavailable. The original photo can still be sent."; color: Theme.muted; font-size: Theme.type-body; wrap: word-wrap; vertical-alignment: center; horizontal-alignment: center; }
                Text { text: root.outgoing-name; color: Theme.text; font-size: Theme.type-body; overflow: elide; }
                Text { text: root.outgoing-size; color: Theme.muted; font-size: Theme.type-small; }
                if root.outgoing-photo: Link { text: root.outgoing-as-file ? "Send as photo" : "Send as file (original)"; clicked => { root.outgoing-as-file = !root.outgoing-as-file; } }
                Input { text <=> root.outgoing-caption; }
                Text { text: "Caption (optional, up to 1024 characters)"; color: Theme.muted; font-size: Theme.type-small; }
                HorizontalLayout { alignment: end; spacing: 12px;
                    Link { text: "Cancel"; width: 100px; clicked => { root.cancel-outgoing(); } }
                    Action { text: "Send"; width: 100px; enabled: !root.blocked; clicked => { root.send-outgoing(); } }
                }
            }
        }
        }
    }
    if root.menu-open: TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        clicked => { root.menu-open = false; }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down { root.menu-open = false; }
        }
        scroll-event(event) => { root.menu-open = false; return reject; }
        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.menu-open = false; return accept; }
                return reject;
            }
        }
        // Quick reactions float above the menu, as in Telegram Desktop.
        menu-panel := Rectangle {
            width: 210px; height: items.preferred-height;
            x: min(root.menu-x, root.width - self.width - 8px);
            y: max(root.menu-can-react ? 58px : 8px, min(root.menu-y, root.height - self.height - 8px));
            background: Theme.menu; border-radius: Theme.radius-panel;
            border-width: 1px; border-color: Theme.menu-edge;
            drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: Theme.shadow;
            items := VerticalLayout {
                padding-top: 6px; padding-bottom: 6px;
                MenuRow {
                    text: "Reply"; enabled: root.menu-can-reply; clicked => { root.menu-pick(0); }
                    icon: "M10 8 L4 13 L10 18 M4 13 H14 C17.9 13 21 16.1 21 20";
                }
                if root.menu-can-edit: MenuRow {
                    text: "Edit"; clicked => { root.menu-pick(1); }
                    icon: "M4 20 L4.6 16.4 L15.5 5.5 L18.5 8.5 L7.6 19.4 Z M13.5 7.5 L16.5 10.5";
                }
                MenuRow {
                    text: "Copy Text"; clicked => { root.menu-pick(2); }
                    icon: "M9 8 H18 C18.6 8 19 8.4 19 9 V20 C19 20.6 18.6 21 18 21 H9 C8.4 21 8 20.6 8 20 V9 C8 8.4 8.4 8 9 8 Z M5 16 V4.5 C5 3.7 5.7 3 6.5 3 H15";
                }
                MenuRow {
                    text: "Forward"; enabled: root.menu-can-forward; clicked => { root.menu-pick(3); }
                    icon: "M14 8 L20 13 L14 18 M20 13 H10 C6.1 13 3 16.1 3 20";
                }
                if root.menu-can-reveal: MenuRow {
                    text: "Show in folder"; clicked => { root.menu-pick(6); }
                    icon: "M3 7 H10 L12 10 H21 V21 H3 Z M3 7 V4 H9 L12 7";
                }
                MenuRow {
                    text: "Delete"; enabled: root.menu-can-delete; clicked => { root.menu-pick(4); }
                    icon: "M4 7 H20 M9.5 7 V4.5 H14.5 V7 M6 7 L7 20 H17 L18 7 M10 11 V16.5 M14 11 V16.5";
                }
            }
        }
        if root.menu-can-react: Rectangle {
            width: root.quick-reactions.length * 36px + 12px; height: 44px;
            x: max(8px, min(menu-panel.x, root.width - self.width - 8px));
            y: menu-panel.y - self.height - 6px;
            background: Theme.menu; border-radius: self.height / 2;
            border-width: 1px; border-color: Theme.menu-edge;
            drop-shadow-blur: 16px; drop-shadow-offset-y: 4px; drop-shadow-color: Theme.shadow;
            for quick[index] in root.quick-reactions: Rectangle {
                x: 6px + index * 36px; y: 4px; width: 36px; height: 36px; border-radius: self.height / 2;
                background: quick.chosen ? Theme.reaction-picked : quick-touch.has-hover ? Theme.menu-hover : transparent;
                Image { x: 5px; y: 5px; width: 26px; height: 26px; source: quick.emoji; image-fit: contain; }
                quick-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.menu-open = false;
                        root.react(root.menu-key, quick.reaction);
                    }
                }
            }
        }
    }
}

// Media viewer: a separate window, as in Telegram Desktop. The video is drawn by a native child
// window over the area above the control bar; the Rust side places it from this window's size.
component BufferSpinner inherits Rectangle {
    width: 16px; height: 16px;
    property <angle> spin: 0deg;
    init => { self.spin = 360deg; }
    animate spin { duration: 800ms; iteration-count: -1; }
    Path { width: parent.width; height: parent.height; transform-rotation: parent.spin;
        viewbox-width: 16; viewbox-height: 16; fill: transparent; stroke: Theme.on-strong; stroke-width: 2px;
        commands: "M8 1 A7 7 0 1 1 1 8"; }
}
export component MediaViewer inherits Window {
    title: "Veygram - Media viewer";
    icon: @image-url("icon.png");
    background: Theme.media-black;
    // Borderless and centred over a dimmed backdrop by the player, as in Telegram Desktop.
    no-frame: true;
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 240px;
    min-height: 160px;
    default-font-family: "Segoe UI";
    in property <bool> loading;
    in property <bool> playing;
    in property <bool> failed;
    in property <float> progress;
    in property <float> download-start;
    in property <float> download-end;
    in property <string> time;
    out property <length> bar: 64px;
    callback toggle();
    callback seek(fraction: float);
    callback dismiss();
    callback area-changed();
    changed width => { root.area-changed(); }
    changed height => { root.area-changed(); }

        FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if event.text == Key.Escape { root.dismiss(); return accept; }
                if event.text == " " { root.toggle(); return accept; }
                return reject;
            }
        }
        if root.loading || root.failed: Text {
            width: parent.width; height: parent.height - root.bar;
            text: root.failed ? "This video cannot be played." : "Loading video...";
            color: Theme.on-strong-3; font-size: Theme.type-title; horizontal-alignment: center; vertical-alignment: center;
        }
        Rectangle {
            y: parent.height - root.bar; height: root.bar; background: Theme.panel;
            Rectangle {
                x: 14px; y: 12px; width: 40px; height: 40px; border-radius: self.height / 2;
                background: toggle-touch.has-hover ? Theme.hover : transparent;
                if root.playing: Path { x: 13px; y: 11px; width: 14px; height: 18px; viewbox-width: 14; viewbox-height: 18; fill: Theme.on-strong; commands: "M0 0 L5 0 L5 18 L0 18 Z M9 0 L14 0 L14 18 L9 18 Z"; }
                if !root.playing: Path { x: 14px; y: 11px; width: 15px; height: 18px; viewbox-width: 15; viewbox-height: 18; fill: Theme.on-strong; commands: "M0 0 L15 9 L0 18 Z"; }
                toggle-touch := TouchArea { clicked => { root.toggle(); } }
            }
            if root.loading: BufferSpinner { x: 53px; y: 24px; }
            seek := Rectangle {
                x: 70px; y: 16px; width: parent.width - 70px - 170px; height: 32px;
                Rectangle { y: 14px; height: 4px; border-radius: self.height / 2; background: Theme.track; }
                Rectangle { x: parent.width * clamp(root.download-start,0,1); y: 14px; height: 4px; width: parent.width * clamp(root.download-end - root.download-start,0,1); background: Theme.on-strong-3; }
                Rectangle { x: 0px; y: 14px; height: 4px; border-radius: self.height / 2; background: Theme.accent; width: parent.width * clamp(root.progress, 0, 1); }
                Rectangle {
                    x: parent.width * clamp(root.progress, 0, 1) - 6px; y: 10px; width: 12px; height: 12px; border-radius: self.height / 2;
                    background: Theme.on-strong; visible: seek-touch.has-hover;
                }
                seek-touch := TouchArea { clicked => { root.seek(self.mouse-x / self.width); } }
            }
            Text {
                x: parent.width - 160px; width: 100px; height: parent.height; text: root.time;
                color: Theme.muted; font-size: Theme.type-small; horizontal-alignment: right; vertical-alignment: center;
            }
            Rectangle {
                x: parent.width - 52px; y: 12px; width: 40px; height: 40px; border-radius: self.height / 2;
                background: close-touch.has-hover ? Theme.hover : transparent;
                Path { x: 13px; y: 13px; width: 14px; height: 14px; viewbox-width: 14; viewbox-height: 14; stroke: Theme.on-strong; stroke-width: 2px; fill: transparent; commands: "M1 1 L13 13 M13 1 L1 13"; }
                close-touch := TouchArea { clicked => { root.dismiss(); } }
            }
        }
    }
